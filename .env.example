# ============================================================
#  Cosmetics Data Platform — environment template
#  Copy thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
#    cp .env.example .env
# ============================================================

# ---- Databricks ----
# Host workspace (Community Edition: https://community.cloud.databricks.com).
# Rotate token định kỳ; prod nên dùng secret backend thay vì file .env.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi<your-personal-access-token>
# Cluster ID chạy notebook (lấy từ URL Databricks: ...#setting/clusters/<ID>/configuration).
# KHÔNG cần cho luồng dbt-databricks (dbt dùng SQL Warehouse qua HOST+TOKEN+HTTP_PATH).
# Chỉ dùng cho notebook path (DatabricksSubmitRunOperator) + Databricks Asset Bundle (infra/).
# CE: có thể không submit Job được.
DATABRICKS_CLUSTER_ID=

# ---- Airflow: mã hoá metadata DB (Fernet) ----
# Sinh key mới:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=FB1Z_3ee-AbcDeFghIjKlMnOpQrStUvWxYz12345678=

# ---- Airflow: metadata Postgres ----
AIRFLOW_PG_USER=airflow
AIRFLOW_PG_PASSWORD=airflow_password
AIRFLOW_PG_DB=airflow_metadata

# ---- Airflow: web UI admin ----
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=cosmetics_2026

# ---- Slack/Email alert (Phase 3 — observability) ----
# Bỏ trống nếu chưa dùng; DAG sẽ fallback sang log khi SLACK_WEBHOOK_URL rỗng.
SLACK_WEBHOOK_URL=
ALERT_EMAIL_TO=

# ---- Grafana (observability) ----
GRAFANA_ADMIN_PASSWORD=admin
